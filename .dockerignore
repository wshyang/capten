# .dockerignore — Exclusions for UAT & Prod Docker builds
node_modules
dist
build
coverage
.git
.gitignore
.dockerignore
Dockerfile

# Exclude all training checkpoints (926MB) — only public/checkpoints/ is bundled by Vite
checkpoints/

# Exclude training and utility scripts
scripts/
*.sh

# Exclude environment files
.env
.env.*

# Exclude intermediate state files
*.tmp
*.log

# Exclude IDE and operating system files
.vscode
.idea
.DS_Store
*.swp

# Exclude test cache and reports
.vitest
.cache
